// rename to devcontainer.json
{
    "name": "hiilikartta-service",
    "dockerComposeFile": [
        "../docker-compose.yml"
    ],
    "service": "app-dev",
    "workspaceFolder": "/app",
    "customizations": {
        "vscode": {
            "extensions": [
                "charliermarsh.ruff",
                "docker.docker",
                "esbenp.prettier-vscode",
                "github.copilot",
                "github.copilot-chat",
                "github.vscode-pull-request-github",
                "ms-azuretools.vscode-docker",
                "ms-python.debugpy",
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers",
                "ms-toolsai.vscode-jupyter-cell-tags",
                "ms-toolsai.vscode-jupyter-slideshow",
                "openai.chatgpt"
            ],
            "settings": {
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff"
                },
                "ruff.format": true
            }
        }
    },
    "runServices": [
        "app-dev",
        "worker-dev",
        "redis-dev",
        "state-db-dev",
        "state-db-test"
    ],
    "remoteUser": "root",
    "containerUser": "root"
    // For binding ssh agent to the container, if needed for Git (for example)
    // "mounts": [
    //     "type=bind,source=${localEnv:HOME}/.ssh/sockets,target=/ssh-sockets",
    // "source=${localEnv:HOME}/.codex,target=/root/.codex,type=bind,consistency=cached"
    //     // "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
    // ],
    // "mounts": [ // newer attempt
        //     "type=bind,source=${localEnv:HOME}/.ssh/sockets,target=/ssh-sockets",
        // "source=${localWorkspaceFolder}/.codex,target=/root/.codex,type=bind,consistency=cached",
        // "type=bind,source=${localEnv:HOME}/.codex/auth.json,target=/root/.codex/auth.json,consistency=cached",
        // "source=${localWorkspaceFolder}/.claude,target=/root/.claude,type=bind,consistency=cached",
        // "type=bind,source=${localEnv:HOME}/.claude/.credentials.json,target=/root/.claude/.credentials.json,consistency=cached"
    // "remoteEnv": {
    //     "SSH_AUTH_SOCK": "/ssh-sockets/agent.sock"
    // }
}