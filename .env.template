COMPOSE_FILE=docker-compose.dev.yml

APP_PORT=8000

# for dev
# -----------------------
DEBUG=True

NOTEBOOK_PORT=8888
NOTEBOOK_TOKEN=amazingtoken

# Database settings
GIS_PG_PASSWORD=
GIS_PG_USER=
GIS_PG_DB=
GIS_PG_PORT=5432
GIS_PG_HOST=gis-db-hostname

STATE_PG_PASSWORD=state_dev_password
STATE_PG_USER=state_dev_user
# Safety rail (dev): dev containers refuse to start unless STATE_PG_DB contains "dev"
STATE_PG_DB=state_dev_db
STATE_PG_PORT=5432
STATE_PG_HOST=state-db-dev

STATE_PG_TEST_PASSWORD=state_test_password
STATE_PG_TEST_USER=state_test_user
# Safety rail (tests): tests refuse to run unless STATE_PG_TEST_DB contains "test"
STATE_PG_TEST_DB=state_test_db
STATE_PG_TEST_PORT=5432
STATE_PG_TEST_HOST=state-db-test

# Production safety: state DB migrations (prod entrypoints)
# check: refuse to start if DB is not at Alembic head
# upgrade: run migrations before starting (API container only)
STATE_DB_MIGRATION_MODE=check

# for traefik proxying, to separate multiple projects on the same network
TRAEFIK_STACK=dev

# Database Pool settings (per engine)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# GIS Throttling settings
# Local semaphore: limits concurrent GIS ops per process/worker
GIS_LOCAL_MAX_CONCURRENT=1
# Distributed semaphore: limits concurrent GIS ops across all processes (via Redis)
GIS_DISTRIBUTED_MAX_CONCURRENT=5
# Time-to-live for distributed slots in seconds (prevents deadlocks from crashed processes)
GIS_SLOT_TTL=7200
# Max runtime for a single GIS SQL statement in seconds (Postgres statement_timeout).
# If exceeded, the current feature is skipped as a permanent failure.
GIS_STATEMENT_TIMEOUT_SECONDS=7200

DEBUG=1
GIT_SSH_KEY=

REDIS_DATA_PATH="../redis_data"
SAQ_WEB_PORT=8001
# SAQ worker process count (dev/prod)
SAQ_WORKERS_COUNT=3

DOMAIN="service.example.org"

ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_DOMAIN=https://...

# Umami Analytics (production only)
# Set UMAMI_ENABLED=true only in production
UMAMI_ENABLED=false
UMAMI_HOST_URL=https://your-umami-instance.com
UMAMI_WEBSITE_ID=your-website-id-here
