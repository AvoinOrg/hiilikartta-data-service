COMPOSE_FILE=docker-compose.dev.yml

# for dev
# -----------------------
DEV_PORT=8000
DEBUG=True

NOTEBOOK_PORT=8888
NOTEBOOK_TOKEN=amazingtoken

# Database settings
GIS_PG_PASSWORD=
GIS_PG_USER=
GIS_PG_DB=
GIS_PG_PORT=5432
GIS_PG_HOST=gis-db-hostname

STATE_PG_PASSWORD=state_dev_password
STATE_PG_USER=state_dev_user
STATE_PG_DB=state_dev_db
STATE_PG_PORT=5432
STATE_PG_HOST=state-db-dev

STATE_PG_TEST_PASSWORD=state_test_password
STATE_PG_TEST_USER=state_test_user
STATE_PG_TEST_DB=state_test_db
STATE_PG_TEST_PORT=5432
STATE_PG_TEST_HOST=state-db-test

# Database Pool settings (per engine)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# GIS Throttling settings
# Local semaphore: limits concurrent GIS ops per process/worker
GIS_LOCAL_MAX_CONCURRENT=3
# Distributed semaphore: limits concurrent GIS ops across all processes (via Redis)
GIS_DISTRIBUTED_MAX_CONCURRENT=5
# Time-to-live for distributed slots in seconds (prevents deadlocks from crashed processes)
GIS_SLOT_TTL=7200
# Max time to wait for a GIS operation slot in seconds
GIS_OPERATION_TIMEOUT=7200

DEBUG=1
GIT_SSH_KEY=

REDIS_DATA_PATH="../redis_data"
SAQ_WEB_PORT=8001

DOMAIN="service.example.org"

ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
ZITADEL_DOMAIN=https://...

# Umami Analytics (production only)
# Set UMAMI_ENABLED=true only in production
UMAMI_ENABLED=false
UMAMI_HOST_URL=https://your-umami-instance.com
UMAMI_WEBSITE_ID=your-website-id-here